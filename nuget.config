<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Fallout (Chris's C#/.NET build system, NUKE successor) ships its edge
         channel here — consumed ONLY by the Fallout build under build/. -->
    <add key="fallout" value="https://nuget.pkg.github.com/Fallout-build/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <!-- Fallout-build GitHub Packages needs auth. Token comes from the
         GITHUB_PACKAGES_PAT env var (fine-grained PAT with read:packages);
         never hard-coded — %VAR% is expanded by NuGet at restore. In CI it's
         wired from the PACKAGES_PAT secret (see .github/workflows). -->
    <fallout>
      <add key="Username" value="ChrisonSimtian" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_PAT%" />
    </fallout>
  </packageSourceCredentials>
  <!-- Route Fallout.* exclusively to the Fallout-build edge feed (a more-specific
       pattern than the nuget.org '*' catch-all, so it wins); everything else
       (SSH.NET, runtime deps) resolves from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="fallout">
      <package pattern="Fallout.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
