<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- nuget.org ONLY. Fallout.* (the build system, used only by build/) is the 10.4.0
         stable line there. It used to come from the Fallout-build GitHub Packages feed,
         pinned to a 2026.1.0-preview edge build that has since been pulled; that feed
         and the PACKAGES_PAT it needed are no longer in the build path. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
