<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>synosharp</ToolCommandName>
    <PackageId>SynoSharp.Cli</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>CLI for SynoSharp — read and discover Synology DSM from the shell.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SynoSharp/SynoSharp.csproj" />
  </ItemGroup>

</Project>
